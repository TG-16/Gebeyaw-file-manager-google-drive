# ==========================================
# Sensitive Credentials & Environment Files
# ==========================================
.env
.env.*
!.env.example
server/.env
client/.env
client/.env.local
client/.env.*.local
client/.env.production
!client/.env.development

# Google Cloud OAuth & Service Account Keys
*client_secret*.json
*credentials*.json
*service-account*.json
token.json
tokens.json

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ==========================================
# Local Uploads & Media Storage
# ==========================================
# Personal files, photos, audios, and videos
server/uploads/
uploads/
tmp/
temp/

# ==========================================
# Dependencies
# ==========================================
node_modules/
server/node_modules/
client/node_modules/

# ==========================================
# Production Builds
# ==========================================
dist/
client/dist/
build/
client/build/
server/deployments

# ==========================================
# Logs & Debugging
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & IDE Metadata
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=file_manager
DB_USER=root
DB_PASS=

# JWT Secrets (Change these in production)
JWT_ACCESS_SECRET=super_secret_access_key_change_me_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_production_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Cloud OAuth & Drive Settings
# Follow the Google Cloud Setup Guide in requirement_v1.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# File Upload Settings
MAX_FILE_SIZE_MB=50

# Client Application URL
CLIENT_URL=http://localhost:5173
